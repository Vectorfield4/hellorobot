# Frontend site URL (used for canonical/sitemap)
PUBLIC_SITE_URL=https://hellorobot.ru

# WordPress + WooCommerce + WPGraphQL backend
PUBLIC_WP_URL=https://hello-robot.ru
PUBLIC_WP_GRAPHQL_URL=https://hello-robot.ru/graphql

# Catalog reads go to WooCommerce Store API (no keys, build time).
# Demo products appear in dev; in a production build the catalog is empty
# unless this is set to "demo".
PUBLIC_PRODUCTS_FALLBACK=off

# Optional: product import (WC REST v3) writes products and tags.
HELLOROBOT_WC_KEY=
HELLOROBOT_WC_SECRET=
