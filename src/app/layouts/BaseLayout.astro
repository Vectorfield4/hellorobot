---
interface Props {
  title?: string;
  description?: string;
}
const { title = "hellorobot", description = "" } = Astro.props;
const locale = Astro.currentLocale ?? "ru";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {import.meta.env.DEV && (
      <>
        <link rel="stylesheet" href="/virtual:stylex.css" />
        <script is:inline src="/@id/virtual:stylex:css-only"></script>
      </>
    )}
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root { --color-bg: #ffffff; --color-fg: #111111; }
  [data-theme="dark"] { --color-bg: #111111; --color-fg: #ffffff; }
  body {
    margin: 0;
    background: #e8eef5;
    color: #111111;
    padding: 1.5rem 0;
    font-family: system-ui, sans-serif;
  }
  main {
    background: #ffffff;
    color: #111111;
    border-radius: 0.5rem;
  }
  /*
   * Islands are server-rendered, so hold the cards at their reveal start
   * position until hydration hands them to GSAP. Without JS the class is
   * never added and the cards render normally.
   */
  html.js [data-reveal-pending] {
    opacity: 0;
    transform: translateY(-10px);
    will-change: opacity, transform;
  }
</style>
