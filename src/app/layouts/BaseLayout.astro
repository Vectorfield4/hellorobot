---
import { Image } from "astro:assets";
import logo from "../../shared/assets/images/hellorobot-logo.png";

interface Props {
  title?: string;
  description?: string;
}
const { title = "hellorobot", description = "" } = Astro.props;
const locale = Astro.currentLocale ?? "ru";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.href} />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header style="background: #1f1f1f; padding: 0.75rem 2rem;">
      <a href="/">
        <Image
          src={logo}
          alt="hellorobot"
          widths={[320, 480, 640]}
          sizes="(max-width: 768px) 320px, 480px"
          width={480}
          height={160}
          style="height: 2.5rem; width: auto; display: block;"
        />
      </a>
    </header>
    <slot />
  </body>
</html>
<style is:global>
  :root { --color-bg: #ffffff; --color-fg: #111111; }
  [data-theme="dark"] { --color-bg: #111111; --color-fg: #ffffff; }
  body { margin: 0; background: var(--color-bg); color: var(--color-fg); font-family: system-ui, sans-serif; }
</style>
