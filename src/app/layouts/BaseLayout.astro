---
interface Props {
  title?: string;
  description?: string;
}
const { title = "hellorobot", description = "" } = Astro.props;
const locale = Astro.currentLocale ?? "ru";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {import.meta.env.DEV && (
      <>
        <link rel="stylesheet" href="/virtual:stylex.css" />
        <script is:inline src="/@id/virtual:stylex:css-only"></script>
      </>
    )}
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        function isPaginated() {
          var p = (location.pathname || "").replace(/\/+$/, "");
          return /\/news\/page\/\d+$/.test(p) || /\/tags\/[^/]+\/page\/\d+$/.test(p);
        }
        if (!isPaginated()) return;

        // Двойной длинный скролл вверх на вершине пагинированной страницы
        // отправляет на главную. Один длинный жест (трекпад/палец) не должен
        // засчитываться несколько раз: события колеса коалесцируются в один жест,
        // а короткие «нервные» дёрганья игнорируются по накопленной дельте.
        var THRESHOLD = 2;          // сколько длинных жестов нужно для перехода
        var MIN_LONG = 100;         // накопленный deltaY (px) = «длинный скролл»
        var GESTURE_END = 300;      // мс тишины, после которых жест завершён
        var ATTEMPT_GAP = 1200;     // мс между жестами: больше — сброс счётчика
        var MIN_SWIPE = 100;        // px для тач-свайпа

        var count = 0;
        var attemptTimer = null;
        var touchStartY = null;
        var touchStartedAtTop = false;
        var touchCounted = false;

        // состояние текущего wheel-жеста
        var gestureActive = false;
        var gestureTimer = null;
        var gestureDelta = 0;
        var gestureCounted = false;

        function atTop() {
          return (window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0) <= 2;
        }

        function resetGestureState() {
          gestureActive = false;
          gestureDelta = 0;
          gestureCounted = false;
          if (gestureTimer) { clearTimeout(gestureTimer); gestureTimer = null; }
        }

        function resetAll() {
          count = 0;
          resetGestureState();
          if (attemptTimer) { clearTimeout(attemptTimer); attemptTimer = null; }
        }

        function scheduleGestureEnd() {
          if (gestureTimer) clearTimeout(gestureTimer);
          gestureTimer = setTimeout(function () {
            resetGestureState();
          }, GESTURE_END);
        }

        function countGesture() {
          count++;
          if (attemptTimer) clearTimeout(attemptTimer);
          attemptTimer = setTimeout(function () { count = 0; }, ATTEMPT_GAP);
          if (count >= THRESHOLD) {
            window.location.href = "/";
          }
        }

        window.addEventListener("wheel", function (e) {
          if (!atTop()) { resetAll(); return; }
          if (e.deltaY < 0) {
            var delta = Math.abs(e.deltaY);
            if (e.deltaMode === 1) delta *= 16;
            else if (e.deltaMode === 2) delta *= window.innerHeight;
            if (!gestureActive) {
              gestureActive = true;
              gestureDelta = delta;
              gestureCounted = gestureDelta >= MIN_LONG;
              if (gestureCounted) countGesture();
              scheduleGestureEnd();
            } else {
              gestureDelta += delta;
              if (!gestureCounted && gestureDelta >= MIN_LONG) {
                gestureCounted = true;
                countGesture();
              }
              scheduleGestureEnd();
            }
          } else if (e.deltaY > 0) {
            resetAll();
          }
        }, { passive: true });

        window.addEventListener("touchstart", function (e) {
          if (e.touches && e.touches[0]) touchStartY = e.touches[0].clientY;
          touchStartedAtTop = atTop();
          touchCounted = false;
        }, { passive: true });

        window.addEventListener("touchmove", function (e) {
          if (touchStartY === null || !touchStartedAtTop || !atTop()) return;
          var y = (e.touches && e.touches[0]) ? e.touches[0].clientY : touchStartY;
          if (!touchCounted && y - touchStartY >= MIN_SWIPE) {
            touchCounted = true;
            countGesture();
          }
        }, { passive: true });

        window.addEventListener("touchend", function () {
          touchStartY = null;
          touchStartedAtTop = false;
          touchCounted = false;
        }, { passive: true });

        window.addEventListener("scroll", function () {
          if (!atTop()) resetAll();
        }, { passive: true });
      })();
    </script>
  </body>
</html>
<style is:global>
  :root { --color-bg: #ffffff; --color-fg: #111111; }
  [data-theme="dark"] { --color-bg: #111111; --color-fg: #ffffff; }
  html {
    overscroll-behavior-x: none;
    overscroll-behavior-y: none;
    touch-action: pan-y;
  }
  body {
    margin: 0;
    background: #e8eef5;
    color: #111111;
    padding: 1.5rem 0;
    font-family: system-ui, sans-serif;
    overscroll-behavior-x: none;
    overscroll-behavior-y: none;
    touch-action: pan-y;
  }
  main {
    background: #ffffff;
    color: #111111;
    border-radius: 0.5rem;
  }
  /*
   * Islands are server-rendered, so hold the cards at their reveal start
   * position until hydration hands them to GSAP. Without JS the class is
   * never added and the cards render normally.
   */
  html.js [data-reveal-pending] {
    opacity: 0;
    transform: translateY(-10px);
    will-change: opacity, transform;
  }
  html.js [data-logo-reveal-pending] {
    opacity: 0;
    transform: translate3d(4.75rem, 0, 0) scale(0.96);
    will-change: opacity, transform;
  }
  html.js [data-divider-pending] {
    opacity: 0;
    transform: translate3d(4.75rem, 0, 0) scale(0.96);
    will-change: opacity, transform;
  }
  @media (max-width: 48rem) {
    html.js [data-logo-reveal-pending] {
      transform: translate3d(2.75rem, 0, 0) scale(0.96);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js [data-logo-reveal-pending] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
    html.js [data-divider-pending] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>
