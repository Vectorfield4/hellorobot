---
interface Props {
  title?: string;
  description?: string;
}
const { title = "hellorobot", description = "" } = Astro.props;
const locale = Astro.currentLocale ?? "ru";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {import.meta.env.DEV && (
      <>
        <link rel="stylesheet" href="/virtual:stylex.css" />
        <script is:inline src="/@id/virtual:stylex:css-only"></script>
      </>
    )}
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="scroll-hint" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      (function () {
        function isPaginated() {
          var p = (location.pathname || "").replace(/\/+$/, "");
          return /\/news\/page\/\d+$/.test(p) || /\/tags\/[^/]+\/page\/\d+$/.test(p);
        }
        if (!isPaginated()) return;

        // Три длинных скролла вверх на вершине пагинированной страницы
        // отправляют на главную. Один длинный жест (трекпад/палец) не должен
        // засчитываться несколько раз: события колеса коалесцируются в один жест,
        // а короткие «нервные» дёрганья игнорируются по накопленной дельте.
        var THRESHOLD = 3;          // сколько длинных жестов нужно для перехода
        var MIN_LONG = 100;         // накопленный deltaY (px) = «длинный скролл»
        var GESTURE_END = 300;      // мс тишины, после которых жест завершён
        var ATTEMPT_GAP = 1200;     // мс между жестами: больше — сброс счётчика
        var MIN_SWIPE = 100;        // px для тач-свайпа
        var HINT_ARMED = "scroll-hint-armed";
        var HINT_HOT = "scroll-hint-hot";
        var HINT_CHARGED = "scroll-hint-charged";
        var REDIRECT_DELAY = 360;   // мс на финальный рост полоски перед переходом

        var count = 0;
        var attemptTimer = null;
        var redirectTimer = null;
        var touchStartY = null;
        var touchStartedAtTop = false;
        var touchCounted = false;

        // состояние текущего wheel-жеста
        var gestureActive = false;
        var gestureStartedAtTop = false;
        var gestureTimer = null;
        var gestureDelta = 0;
        var gestureCounted = false;

        function atTop() {
          return (window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0) <= 2;
        }

        function resetGestureState() {
          gestureActive = false;
          gestureStartedAtTop = false;
          gestureDelta = 0;
          gestureCounted = false;
          if (gestureTimer) { clearTimeout(gestureTimer); gestureTimer = null; }
        }

        // Полоска растёт ступенями: первый жест зажигает её, второй делает
        // заметнее, третий раздувает перед самым переходом на главную.
        function setHintLevel(level) {
          var root = document.documentElement;
          root.classList.toggle(HINT_ARMED, level >= 1);
          root.classList.toggle(HINT_HOT, level >= 2);
          root.classList.toggle(HINT_CHARGED, level >= 3);
        }

        function resetCount() {
          count = 0;
          setHintLevel(0);
          if (attemptTimer) { clearTimeout(attemptTimer); attemptTimer = null; }
          if (redirectTimer) { clearTimeout(redirectTimer); redirectTimer = null; }
        }

        function resetAll() {
          resetCount();
          resetGestureState();
        }

        function scheduleGestureEnd() {
          if (gestureTimer) clearTimeout(gestureTimer);
          gestureTimer = setTimeout(function () {
            resetGestureState();
          }, GESTURE_END);
        }

        function countGesture() {
          count++;
          setHintLevel(count);
          if (attemptTimer) clearTimeout(attemptTimer);
          if (count >= THRESHOLD) {
            // Не уходим сразу: даём полоске дорасти до максимума, чтобы
            // третий жест читался как осознанный переход.
            if (redirectTimer) clearTimeout(redirectTimer);
            redirectTimer = setTimeout(function () {
              window.location.href = "/";
            }, REDIRECT_DELAY);
            return;
          }
          attemptTimer = setTimeout(function () {
            count = 0;
            setHintLevel(0);
          }, ATTEMPT_GAP);
        }

        window.addEventListener("wheel", function (e) {
          if (e.deltaY > 0) { resetAll(); return; }
          if (e.deltaY === 0) return;

          var delta = Math.abs(e.deltaY);
          if (e.deltaMode === 1) delta *= 16;
          else if (e.deltaMode === 2) delta *= window.innerHeight;

          if (!gestureActive) {
            gestureActive = true;
            // Жест, начатый ниже верха, не засчитывается, даже если страница
            // доедет до верха в процессе этого же движения.
            gestureStartedAtTop = atTop();
            gestureDelta = gestureStartedAtTop ? delta : 0;
            gestureCounted = false;
            if (gestureStartedAtTop && gestureDelta >= MIN_LONG) {
              gestureCounted = true;
              countGesture();
            }
            scheduleGestureEnd();
            return;
          }

          // Продлеваем текущий жест, но не начинаем счёт задним числом.
          scheduleGestureEnd();
          if (!gestureStartedAtTop) return;
          if (!atTop()) {
            gestureStartedAtTop = false;
            gestureDelta = 0;
            gestureCounted = false;
            resetCount();
            return;
          }
          gestureDelta += delta;
          if (!gestureCounted && gestureDelta >= MIN_LONG) {
            gestureCounted = true;
            countGesture();
          }
        }, { passive: true });

        window.addEventListener("touchstart", function (e) {
          if (e.touches && e.touches[0]) touchStartY = e.touches[0].clientY;
          touchStartedAtTop = atTop();
          touchCounted = false;
        }, { passive: true });

        window.addEventListener("touchmove", function (e) {
          if (touchStartY === null || !touchStartedAtTop || !atTop()) return;
          var y = (e.touches && e.touches[0]) ? e.touches[0].clientY : touchStartY;
          if (!touchCounted && y - touchStartY >= MIN_SWIPE) {
            touchCounted = true;
            countGesture();
          }
        }, { passive: true });

        window.addEventListener("touchend", function () {
          touchStartY = null;
          touchStartedAtTop = false;
          touchCounted = false;
        }, { passive: true });

        window.addEventListener("scroll", function () {
          if (atTop()) return;
          // Не обрываем текущий жест: иначе скролл, начатый ниже верха,
          // мог бы «перезапуститься» и засчитаться уже у самой вершины.
          resetCount();
          gestureStartedAtTop = false;
          gestureDelta = 0;
          gestureCounted = false;
        }, { passive: true });
      })();
    </script>
  </body>
</html>
<style is:global>
  :root { --color-bg: #ffffff; --color-fg: #111111; --color-accent: #0066cc; }
  [data-theme="dark"] { --color-bg: #111111; --color-fg: #ffffff; --color-accent: #66aaff; }
  html {
    overscroll-behavior-x: none;
    overscroll-behavior-y: none;
    touch-action: pan-y;
  }
  body {
    margin: 0;
    background: #e8eef5;
    color: #111111;
    padding: 1.5rem 0;
    font-family: system-ui, sans-serif;
    overscroll-behavior-x: none;
    overscroll-behavior-y: none;
    touch-action: pan-y;
  }
  main {
    background: #ffffff;
    color: #111111;
    border-radius: 0.5rem;
  }
  /*
   * Hint for the hidden scroll gesture: a thin accent line at the very top
   * grows in three steps — armed after the first long upward scroll, hotter
   * after the second, and charged right before the jump home.
   */
  .scroll-hint {
    position: fixed;
    top: 0;
    left: 50%;
    z-index: 10;
    width: min(18rem, 60vw);
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -100%) scaleX(0.4);
    transform-origin: center;
    transition:
      opacity 180ms ease,
      transform 220ms ease,
      width 240ms ease,
      height 240ms ease,
      box-shadow 240ms ease;
  }
  html.scroll-hint-armed .scroll-hint {
    opacity: 0.6;
    transform: translate(-50%, 0) scaleX(1);
  }
  html.scroll-hint-hot .scroll-hint {
    width: min(24rem, 72vw);
    height: 3px;
    opacity: 0.85;
    transform: translate(-50%, 0) scaleX(1.08);
  }
  html.scroll-hint-charged .scroll-hint {
    width: min(38rem, 94vw);
    height: 5px;
    opacity: 1;
    transform: translate(-50%, 0) scaleX(1.16);
    box-shadow: 0 0 18px 2px var(--color-accent);
  }
  /*
   * Islands are server-rendered, so hold the cards at their reveal start
   * position until hydration hands them to GSAP. Without JS the class is
   * never added and the cards render normally.
   */
  html.js [data-reveal-pending] {
    opacity: 0;
    transform: translateY(-10px);
    will-change: opacity, transform;
  }
  html.js [data-logo-reveal-pending] {
    opacity: 0;
    transform: translate3d(4.75rem, 0, 0) scale(0.96);
    will-change: opacity, transform;
  }
  html.js [data-divider-pending] {
    opacity: 0;
    transform: translate3d(4.75rem, 0, 0) scale(0.96);
    will-change: opacity, transform;
  }
  @media (max-width: 48rem) {
    html.js [data-logo-reveal-pending] {
      transform: translate3d(2.75rem, 0, 0) scale(0.96);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      transition: none;
    }
    html.js [data-logo-reveal-pending] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
    html.js [data-divider-pending] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>
