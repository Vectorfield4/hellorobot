---
interface Props {
  title?: string;
  description?: string;
}
const { title = "hellorobot", description = "" } = Astro.props;
const locale = Astro.currentLocale ?? "ru";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {import.meta.env.DEV && (
      <>
        <link rel="stylesheet" href="/virtual:stylex.css" />
        <script is:inline src="/@id/virtual:stylex:css-only"></script>
      </>
    )}
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        function isPaginated() {
          var p = (location.pathname || "").replace(/\/+$/, "");
          return /\/news\/page\/\d+$/.test(p) || /\/tags\/[^/]+\/page\/\d+$/.test(p);
        }
        if (!isPaginated()) return;

        var THRESHOLD = 3;
        var GAP = 1000;
        var count = 0;
        var timer = null;
        var touchStartY = null;
        var touchCounted = false;

        function atTop() {
          return (window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0) <= 2;
        }

        function resetGesture() {
          count = 0;
          if (timer) { clearTimeout(timer); timer = null; }
        }

        function registerAttempt() {
          count++;
          if (timer) clearTimeout(timer);
          timer = setTimeout(function () { count = 0; }, GAP);
          if (count >= THRESHOLD) {
            window.location.href = "/";
          }
        }

        window.addEventListener("wheel", function (e) {
          if (!atTop()) { resetGesture(); return; }
          if (e.deltaY < 0) {
            registerAttempt();
          } else {
            resetGesture();
          }
        }, { passive: true });

        window.addEventListener("touchstart", function (e) {
          if (e.touches && e.touches[0]) touchStartY = e.touches[0].clientY;
          touchCounted = false;
        }, { passive: true });

        window.addEventListener("touchmove", function (e) {
          if (touchStartY === null || !atTop()) return;
          var y = (e.touches && e.touches[0]) ? e.touches[0].clientY : touchStartY;
          if (y - touchStartY > 60 && !touchCounted) {
            touchCounted = true;
            registerAttempt();
          }
        }, { passive: true });

        window.addEventListener("touchend", function () {
          touchStartY = null;
          touchCounted = false;
        }, { passive: true });

        window.addEventListener("scroll", function () {
          if (!atTop()) resetGesture();
        }, { passive: true });
      })();
    </script>
  </body>
</html>
<style is:global>
  :root { --color-bg: #ffffff; --color-fg: #111111; }
  [data-theme="dark"] { --color-bg: #111111; --color-fg: #ffffff; }
  html {
    overscroll-behavior-x: none;
    overscroll-behavior-y: none;
    touch-action: pan-y;
  }
  body {
    margin: 0;
    background: #e8eef5;
    color: #111111;
    padding: 1.5rem 0;
    font-family: system-ui, sans-serif;
    overscroll-behavior-x: none;
    overscroll-behavior-y: none;
    touch-action: pan-y;
  }
  main {
    background: #ffffff;
    color: #111111;
    border-radius: 0.5rem;
  }
  /*
   * Islands are server-rendered, so hold the cards at their reveal start
   * position until hydration hands them to GSAP. Without JS the class is
   * never added and the cards render normally.
   */
  html.js [data-reveal-pending] {
    opacity: 0;
    transform: translateY(-10px);
    will-change: opacity, transform;
  }
  html.js [data-logo-reveal-pending] {
    opacity: 0;
    transform: translate3d(4.75rem, 0, 0) scale(0.96);
    will-change: opacity, transform;
  }
  html.js [data-divider-pending] {
    opacity: 0;
    transform: translate3d(4.75rem, 0, 0) scale(0.96);
    will-change: opacity, transform;
  }
  @media (max-width: 48rem) {
    html.js [data-logo-reveal-pending] {
      transform: translate3d(2.75rem, 0, 0) scale(0.96);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js [data-logo-reveal-pending] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
    html.js [data-divider-pending] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>
