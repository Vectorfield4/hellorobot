---
import BaseLayout from "@/app/layouts/BaseLayout.astro";
import { PRODUCT_PAGE_SIZE } from "@/shared/config/pagination";
import { getAllProductCategories, getProductsByCategory } from "@/shared/data/products";
import ProductListing from "@/shared/ui/product/ProductListing.astro";
import SiteNav from "@/shared/ui/SiteNav.astro";

export async function getStaticPaths() {
  const categories = await getAllProductCategories();
  const paths: { params: { category: string; page: string } }[] = [];

  for (const category of categories) {
    const products = await getProductsByCategory(category.name);
    const totalPages = Math.ceil(products.length / PRODUCT_PAGE_SIZE);
    // Первая страница живёт на /robots/category/<категория>.
    for (let page = 2; page <= totalPages; page++) {
      paths.push({ params: { category: category.name, page: String(page) } });
    }
  }

  return paths;
}

const category = Astro.params.category as string;
const page = Number(Astro.params.page) || 1;
const products = await getProductsByCategory(category);
const totalPages = Math.max(1, Math.ceil(products.length / PRODUCT_PAGE_SIZE));
const start = (page - 1) * PRODUCT_PAGE_SIZE;
const pageProducts = products.slice(start, start + PRODUCT_PAGE_SIZE);
const basePath = `/robots/category/${encodeURIComponent(category)}`;
---

<BaseLayout
  title={`Товары в категории: ${category} — страница ${page}`}
  description={`Страница ${page} категории «${category}»: цены и наличие товаров.`}
>
  <main style="padding: 2rem; max-width: 48rem; margin: 0 auto;">
    <SiteNav current="catalog" />
    <h1 style="margin-top: 0;">Товары в категории: {category}</h1>
    <p style="opacity: 0.75;">Найдено товаров: {products.length}</p>
    <ProductListing
      products={pageProducts}
      totalPages={totalPages}
      currentPage={page}
      basePath={basePath}
    />
  </main>
</BaseLayout>
