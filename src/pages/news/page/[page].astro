---
import PostListLayout from "../../../app/layouts/PostListLayout.astro";
import { PAGE_SIZE } from "../../../shared/config/pagination";
import { getPosts } from "../../../shared/data/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const totalPages = Math.ceil(posts.length / PAGE_SIZE);
  // Page 1 is the home page, so the numbered route starts at 2.
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const posts = await getPosts();
const page = Number(Astro.params.page) || 1;
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const start = (page - 1) * PAGE_SIZE;
const pagePosts = posts.slice(start, start + PAGE_SIZE);
---
<PostListLayout
  title={`Новости — страница ${page}`}
  initialPosts={pagePosts}
  totalPages={totalPages}
  initialPage={page}
  apiBase="/news/page"
  paginated={true}
>
  <nav style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
    <a href={page > 2 ? `/news/page/${page - 1}` : "/"}>← Назад</a>
    {page < totalPages && <a href={`/news/page/${page + 1}`}>Вперёд →</a>}
    {page === totalPages && <span style="opacity: 0.6;">Вы на последней странице</span>}
  </nav>
  <div style="margin-top: 1rem; text-align: center;">
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
      <a href={n === 1 ? "/" : `/news/page/${n}`} style={`margin: 0 0.5rem; font-weight: ${n === page ? "bold" : "normal"};`}>{n}</a>
    ))}
  </div>
</PostListLayout>