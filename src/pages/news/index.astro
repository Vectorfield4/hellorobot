---
import PostListLayout from "../../app/layouts/PostListLayout.astro";
import { getPosts } from "../../shared/data/posts";

const PAGE_SIZE = 3;
const posts = await getPosts();
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---
<PostListLayout
  title="Новости"
  initialPosts={posts.slice(0, PAGE_SIZE)}
  totalPages={totalPages}
  initialPage={1}
  apiBase="/news/page"
>
  <nav style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
      <a href={`/news/page/${n}`}>{n}</a>
    ))}
  </nav>
</PostListLayout>