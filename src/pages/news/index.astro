---
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { getPosts } from "../../shared/data/posts";
import ArticleCard from "../../shared/ui/ArticleCard";

const posts = await getPosts();
---
<BaseLayout title="Новости">
  <main style="padding: 2rem; max-width: 48rem; margin: 0 auto;">
    <h1>Новости</h1>
    {posts.map((p) => (
      <ArticleCard title={p.title} date={p.date} slug={p.slug} excerpt={p.excerpt} tags={p.tags} />
    ))}
  </main>
</BaseLayout>
