---
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { getPostBySlug, getPosts } from "../../shared/data/posts";
import { splitBuyRobotMarkers } from "../../shared/lib/buyRobotMarkers";
import { formatDate } from "../../shared/lib/formatDate";
import BuyRobotBlock from "../../shared/ui/BuyRobotBlock.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug as string);
if (!post) throw new Error("Not found");

// Маркеры в тексте задают место блока; без маркеров блок идёт один раз в конце.
const segments = splitBuyRobotMarkers(post.content);
const hasMarkers = segments.some((segment) => segment.type === "products");
---
<BaseLayout title={post.title}>
  <main style="padding: 2rem;">
    <h1>{post.title}</h1>
    <small>{formatDate(post.date)}</small>
    {post.tags.length > 0 && (
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin:0.5rem 0;">
        {post.tags.map((t) => (
          <a href={`/tags/${encodeURIComponent(t)}`} style="font-size:0.75rem;padding:0.15rem 0.5rem;border-radius:0.5rem;background:#0066cc;color:#fff;text-decoration:none;">{t}</a>
        ))}
      </div>
    )}
    <article>
      {segments.map((segment) =>
        segment.type === "html" ? (
          <Fragment set:html={segment.value} />
        ) : (
          <BuyRobotBlock tags={segment.tags ?? post.tags} />
        ),
      )}
    </article>
    {!hasMarkers && <BuyRobotBlock tags={post.tags} />}
    <p><a href="/">← Back</a></p>
  </main>
</BaseLayout>
