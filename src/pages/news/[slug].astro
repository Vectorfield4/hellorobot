---
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { getPostBySlug, getPosts } from "../../shared/data/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug as string);
if (!post) throw new Error("Not found");
---
<BaseLayout title={post.title}>
  <main style="padding: 2rem;">
    <h1>{post.title}</h1>
    <small>{post.date}</small>
    {post.tags.length > 0 && (
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin:0.5rem 0;">
        {post.tags.map((t) => (
          <span style="font-size:0.75rem;padding:0.15rem 0.5rem;border-radius:0.5rem;background:#0066cc;color:#fff;">{t}</span>
        ))}
      </div>
    )}
    <article set:html={post.content} />
    <p><a href="/news">← Back</a></p>
  </main>
</BaseLayout>
