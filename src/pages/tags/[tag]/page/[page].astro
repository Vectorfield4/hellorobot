---
import PostListLayout from "../../../../app/layouts/PostListLayout.astro";
import { PAGE_SIZE } from "../../../../shared/config/pagination";
import { getPosts } from "../../../../shared/data/posts";
import BuyRobotBlock from "../../../../shared/ui/BuyRobotBlock.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.tags ?? []))];
  const paths: { params: { tag: string; page: string } }[] = [];
  for (const tag of tags) {
    const tagPosts = posts.filter((p) => (p.tags ?? []).includes(tag));
    const totalPages = Math.max(1, Math.ceil(tagPosts.length / PAGE_SIZE));
    // Page 1 lives at /tags/<tag>, so numbered pages start at 2.
    for (let i = 2; i <= totalPages; i++) {
      paths.push({ params: { tag, page: String(i) } });
    }
  }
  return paths;
}

const { tag, page: pageParam } = Astro.params;
const tagValue = tag as string;
const page = Number(pageParam) || 1;
const allPosts = (await getPosts()).filter((p) => (p.tags ?? []).includes(tagValue));
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const start = (page - 1) * PAGE_SIZE;
const pagePosts = allPosts.slice(start, start + PAGE_SIZE);
const encodedTag = encodeURIComponent(tagValue);
---
<PostListLayout
  title={`Тег ${tagValue} — страница ${page}`}
  initialPosts={pagePosts}
  totalPages={totalPages}
  initialPage={page}
  apiBase={`/tags/${encodedTag}/page`}
  paginated={true}
>
  <h1 slot="heading">Тег: {tagValue}</h1>
  <p><a href="/">← Все новости</a></p>
  {totalPages > 1 && (
    <nav style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
      <a href="/">← Все новости</a>
      {page < totalPages && <a href={`/tags/${encodedTag}/page/${page + 1}`}>Вперёд →</a>}
      {page === totalPages && <span style="opacity: 0.6;">Вы на последней странице</span>}
    </nav>
  )}
  {totalPages > 1 && (
    <div style="margin-top: 1rem; text-align: center;">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
        <a href={n === 1 ? `/tags/${encodedTag}` : `/tags/${encodedTag}/page/${n}`} style={`margin: 0 0.5rem; font-weight: ${n === page ? "bold" : "normal"};`}>{n}</a>
      ))}
    </div>
  )}
  {page === 1 && <BuyRobotBlock tags={[tagValue]} variant="tag" limit={5} seed={`tag:${tagValue}`} />}
</PostListLayout>