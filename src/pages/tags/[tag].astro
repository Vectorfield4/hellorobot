---
import PostListLayout from "../../app/layouts/PostListLayout.astro";
import { PAGE_SIZE } from "../../shared/config/pagination";
import { getPosts } from "../../shared/data/posts";
import BuyRobotBlock from "../../shared/ui/BuyRobotBlock.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.tags ?? []))];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const tagValue = tag as string;
const allPosts = (await getPosts()).filter((p) => (p.tags ?? []).includes(tagValue));
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const pagePosts = allPosts.slice(0, PAGE_SIZE);
const encodedTag = encodeURIComponent(tagValue);
---
<PostListLayout
  title={`Тег: ${tagValue}`}
  initialPosts={pagePosts}
  totalPages={totalPages}
  initialPage={1}
  apiBase={`/tags/${encodedTag}/page`}
>
  <h1 slot="heading">Тег: {tagValue}</h1>
  <p><a href="/">← Все новости</a></p>
  {totalPages > 1 && (
    <nav style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) =>
        n === 1 ? (
          <span aria-current="page" style="font-weight: bold;">
            {n}
          </span>
        ) : (
          <a href={`/tags/${encodedTag}/page/${n}`}>{n}</a>
        ),
      )}
    </nav>
  )}
  <BuyRobotBlock tags={[tagValue]} variant="tag" limit={3} />
</PostListLayout>