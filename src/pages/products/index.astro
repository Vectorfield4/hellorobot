---
import BaseLayout from "@/app/layouts/BaseLayout.astro";
import { STORE_API_URL } from "@/shared/config/constants";
import { PRODUCT_PAGE_SIZE } from "@/shared/config/pagination";
import { type Product, productCategoryPath, productTagPath } from "@/shared/data/product";
import { getAllProductCategories, getAllProductTags, getProducts } from "@/shared/data/products";
import ProductListing from "@/shared/ui/product/ProductListing.astro";
import ProductSearch from "@/shared/ui/product/ProductSearch";
import SiteNav from "@/shared/ui/SiteNav.astro";

const products = await getProducts();
const tags = await getAllProductTags();
const categories = await getAllProductCategories();

const totalPages = Math.max(1, Math.ceil(products.length / PRODUCT_PAGE_SIZE));
const pageProducts = products.slice(0, PRODUCT_PAGE_SIZE);

// Поиск уходит в браузер, поэтому возим только то, что нужно карточке и
// фильтру: описания и лишние снимки остаются на билде.
const searchIndex: Product[] = products.map((product) => ({
  ...product,
  description: "",
  shortDescription: "",
  images: product.cover ? [product.cover] : [],
}));

const chipStyle =
  "font-size:0.8rem;padding:0.2rem 0.6rem;border-radius:0.5rem;background:#0066cc;color:#fff;text-decoration:none;";

const searchToggleStyle =
  "display:inline-flex;align-items:center;gap:0.4rem;margin-left:auto;padding:0.35rem 0.7rem;font:inherit;font-size:0.9rem;color:#0066cc;background:transparent;border:1px solid currentColor;border-radius:0.5rem;cursor:pointer;";
---

<BaseLayout
  title="Каталог роботов — hellorobot"
  description="Гуманоиды, коботы, манипуляторы и четвероногие платформы: характеристики и наличие. Заказ — заявкой на сайте, стоимость и сроки поставки уточняет менеджер."
>
  <main style="padding: 2rem; max-width: 48rem; margin: 0 auto;">
    <SiteNav current="catalog" />

    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
      <h1 style="margin:0;">Каталог роботов</h1>
      {products.length > 0 && (
        <button
          id="catalog-search-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="catalog-search"
          style={searchToggleStyle}
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16.5 16.5 4 4"></path>
          </svg>
          <span data-search-toggle-label>Поиск</span>
        </button>
      )}
    </div>

    <p>
      Мы собираем этот каталог по одному роботу и до сих пор удивляемся, сколько всего уже можно
      заказать: гуманоиды Unitree G1 и Reachy 2, четвероногие Unitree Go2 и B2, коботы Doosan и
      Fairino, манипуляторы и мягкие захваты для хрупких вещей. Часть машин работает в цеху, часть
      стоит на столе в лаборатории, а Microduck берут просто для того, чтобы посмотреть, как утка
      ходит.
    </p>

    <p>
      Детям обычно показывают именно её: Microduck ростом 25 сантиметров ходит на двух ногах, видит
      камерой и лидаром и берёт предметы клювом. Её можно программировать, поэтому на ней хорошо
      объяснять, что робот — не картинка из новостей, а железо, которое падает и учится заново.
    </p>

    <p>
      Для пожилых людей роботы берут на себя другую, менее заметную работу. Мобильные платформы
      вроде EMMA1000L и OMNI развозят грузы по складам и больницам, а в пансионатах то же самое
      делают роботы-доставщики: подвезти лекарства, воду, чистое бельё, чтобы человек не таскал
      тяжести по коридорам. Есть и работа потише — разговор. Reachy Mini поворачивается к
      собеседнику и поддерживает беседу; такие настольные компаньоны берут в лаборатории, где
      изучают, как робот и человек понимают друг друга.
    </p>

    <p>
      Стоимость и наличие подтверждает менеджер: оплата на сайте не проводится. Оставляете заявку в
      карточке робота — вам перезванивают, называют сроки поставки и условия.
    </p>

    {products.length === 0 ? (
      <section style="margin-top: 2rem;">
        <h2 style="font-size: 1.1rem;">Каталог наполняется</h2>
        <p>
          Товары ещё не опубликованы. Пока можно почитать новости робототехники на
          <a href="/"> главной странице</a>.
        </p>
      </section>
    ) : (
      <>
        <div id="catalog-search" hidden style="margin-top: 1.5rem;">
          <ProductSearch client:load products={searchIndex} storeUrl={STORE_API_URL} />
        </div>

        <noscript>
          <!-- Без скрипта кнопка бесполезна: показываем поиск сразу. -->
          <style is:inline>
            #catalog-search-toggle {
              display: none !important;
            }
            #catalog-search {
              display: block !important;
              margin-top: 1.5rem;
            }
          </style>
        </noscript>

        {tags.length > 0 && (
          <nav aria-label="Теги каталога" style="margin-top: 2rem;">
            <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Теги</h2>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              {tags.map((tag) => (
                <a href={productTagPath(tag.name)} style={chipStyle}>
                  {tag.name} <span style="opacity: 0.75;">{tag.count}</span>
                </a>
              ))}
            </div>
          </nav>
        )}

        {categories.length > 0 && (
          <nav aria-label="Категории каталога" style="margin-top: 1.25rem;">
            <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Категории</h2>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              {categories.map((category) => (
                <a
                  href={productCategoryPath(category.name)}
                  style="font-size:0.8rem;padding:0.2rem 0.6rem;border-radius:0.5rem;border:1px solid #0066cc;color:#0066cc;text-decoration:none;"
                >
                  {category.name} <span style="opacity: 0.75;">{category.count}</span>
                </a>
              ))}
            </div>
          </nav>
        )}

        <section style="margin-top: 2rem;">
          <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">
            Все товары <span style="opacity: 0.6;">({products.length})</span>
          </h2>
          <ProductListing
            products={pageProducts}
            totalPages={totalPages}
            currentPage={1}
            basePath="/products"
          />
        </section>

        <p style="margin-top: 2rem;">
          Если хочется не только посмотреть, но и понять, откуда всё это взялось, —
          <a href="/">новости робототехники</a> обновляются каждый день.
        </p>
      </>
    )}
  </main>
</BaseLayout>

<script>
  // Панель поиска лежит в разметке свёрнутой: раскрываем её по кнопке справа
  // от заголовка и уводим фокус в поле, чтобы можно было сразу печатать.
  const toggle = document.getElementById("catalog-search-toggle");
  const panel = document.getElementById("catalog-search");
  const label = toggle?.querySelector("[data-search-toggle-label]");

  if (toggle && panel && label) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Свернуть" : "Поиск";
      if (!open) return;
      panel.querySelector<HTMLInputElement>("input[type='search']")?.focus();
    };

    toggle.addEventListener("click", () => setOpen(panel.hidden));
    panel.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      setOpen(false);
      toggle.focus();
    });
  }
</script>
