---
import BaseLayout from "../app/layouts/BaseLayout.astro";
import { PAGE_SIZE } from "../shared/config/pagination";
import { getPosts } from "../shared/data/posts";
import { astroDictRu } from "../shared/i18n/dict";
import { createT } from "../shared/i18n/t";
import ArticleCard from "../shared/ui/ArticleCard";
import InfinitePosts from "../shared/ui/InfinitePosts";
import LatestPosts from "../shared/ui/LatestPosts";
import Logo from "../shared/ui/Logo.astro";
import NewsTitle from "../shared/ui/NewsTitle.astro";

const t = createT(astroDictRu);
const posts = await getPosts();
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---
<BaseLayout title={t("home.title")}>
  <main style="padding: 2rem; max-width: 48rem; margin: 0 auto;">
    <Logo alt={t("home.title")} />
    <p>{t("home.lead")}</p>

    <NewsTitle as="h2" />
    <LatestPosts client:load first={5} knownSlugs={posts.map((p) => p.slug)} />
    <InfinitePosts client:visible initialPosts={posts.slice(0, PAGE_SIZE)} totalPages={totalPages} />

    {totalPages > 1 && (
      <nav style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) =>
          n === 1 ? (
            <span aria-current="page" style="font-weight: bold;">
              {n}
            </span>
          ) : (
            <a href={`/news/page/${n}`}>{n}</a>
          ),
        )}
      </nav>
    )}
  </main>
</BaseLayout>
