---
import { Image } from "astro:assets";
import logo from "../../shared/assets/images/hellorobot-logo.png";

interface Props {
  alt?: string;
  height?: string;
}

const { alt = "hellorobot", height = "4rem" } = Astro.props;
---
<Image
  src={logo}
  alt={alt}
  widths={[320, 480, 640]}
  sizes="(max-width: 768px) 320px, 480px"
  width={480}
  height={160}
  style={`height: ${height}; width: auto; display: block; margin-bottom: 0.5rem;`}
/>