---
import { productTagPath } from "../data/product";
import { getProductsForTags } from "../data/products";
import ProductCard from "./product/ProductCard";

interface Props {
  /** Теги, по которым ищем товары. Сравнение идёт по канону: `humanoid` = `гуманоиды`. */
  tags: string[];
  limit?: number;
  heading?: string;
  variant?: "article" | "tag";
}

const { tags, limit = 3, heading = "Купить робота", variant = "article" } = Astro.props;

const products = await getProductsForTags(tags, limit);
const tagLink = variant === "article" && tags.length === 1 ? tags[0] : null;
---

{
  products.length > 0 && (
    <section class="buy-robot">
      <h2 class="buy-robot__heading">{heading}</h2>
      <div class="buy-robot__grid">
        {products.map((product) => (
          <ProductCard product={product} compact={variant === "article"} />
        ))}
      </div>
      {tagLink && (
        <p class="buy-robot__more">
          <a href={productTagPath(tagLink)}>Все товары по теме</a>
        </p>
      )}
    </section>
  )
}

<style>
  .buy-robot {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .buy-robot__heading {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .buy-robot__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .buy-robot__more {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
