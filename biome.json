{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.astro",
      "!node_modules",
      "!coverage",
      "!.storybook-static",
      "!docs/research",
      "!docs/wp-*.json",
      "!docs/wp-result-*.json",
      "!data",
      "!products/catalog.json",
      "!src/shared/data/*.snapshot.json"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": { "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" } }
      }
    }
  ]
}
